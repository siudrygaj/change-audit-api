}

tests {
  test("status is 200", function() {
    expect(res.status).to.equal(200);
  });
  
  test("returns 3 exceptions", function() {
    expect(res.body.length).to.equal(3);
  });
}

docs {
  Filter to exceptions. Expected: 200 with 3 tickets.
}
