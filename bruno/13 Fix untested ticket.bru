meta {
  name: 13 Fix untested ticket
  type: http
  seq: 14
}

put {
  url: {{baseUrl}}/changes/{{untestedId}}
  body: json
  auth: none
}

headers {
  X-API-Key: {{apiKey}}
}

body:json {
  {
    "ticketId": "CHG-10003",
    "system": "Workday",
    "description": "Update payroll tax tables for 2027",
    "approvedBy": "msmith",
    "developedBy": "kwilson",
    "deployedBy": "rpatel",
    "approvalDate": "2026-10-08",
    "deployDate": "2026-10-10",
    "tested": true
  }
}

tests {
  test("status is 200", function() {
    expect(res.status).to.equal(200);
  });
  
  test("is now Compliant", function() {
    expect(res.body.controlResult).to.equal("Compliant");
  });
  
  test("risk drops to Low", function() {
    expect(res.body.riskRating).to.equal("Low");
  });
}

docs {
  Testing evidence added, ticket re-audited. Expected: 200, Compliant, Low risk.
}
